# Neon Postgres connection string (eu-central-1 region)
DATABASE_URL=

# Resend API key (EU region sender)
RESEND_API_KEY=

# Mailbox that receives new membership applications
APPLICATION_RECIPIENT_EMAIL=

# Sender address for every outgoing mail — must be on enactus-mannheim.com,
# the only domain verified with Resend.
RESEND_FROM_EMAIL=bewerbung@enactus-mannheim.com

# Reply-To on every outgoing mail — a real, actively read inbox, not the
# sending address above.
RESEND_REPLY_TO_EMAIL=info@unimannheim.enactus.team

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when it
# calls /api/cron/cleanup. Generate with `openssl rand -hex 32` or similar;
# with this unset, the cleanup route rejects every request.
CRON_SECRET=

# Public site URL, used for absolute links (OG images, hreflang, double opt-in confirmation)
# Local fallback matches the old Webflow site's domain — see docs/deployment.md.
NEXT_PUBLIC_SITE_URL=https://www.enactus-mannheim.com

# Shared password gating /admin/bewerbungen. With this unset, the admin
# login route rejects every request rather than running unauthenticated.
# Must be genuinely random — generate with `openssl rand -hex 24` and share
# it via the board's password manager, not a memorable phrase spoken aloud:
# it's compared in constant time, but a weak password is still a weak
# password regardless of how carefully the comparison is written.
ADMIN_PASSWORD=

# Machine-only secret that signs the admin session cookie
# (docs/deployment.md) — deliberately separate from ADMIN_PASSWORD, so a
# leaked cookie never becomes a plaintext/HMAC pair an attacker could
# brute-force the actual password from offline. Generate with `openssl rand
# -hex 32`; with this unset, no session cookie can be issued or verified,
# so the admin login route rejects every request just like a missing
# ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=
