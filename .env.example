# Neon Postgres connection string (eu-central-1 region)
DATABASE_URL=

# Resend API key (EU region sender)
RESEND_API_KEY=

# Mailbox that receives new membership applications
APPLICATION_RECIPIENT_EMAIL=

# Sender address for every outgoing mail — must be on enactus-mannheim.com,
# the only domain verified with Resend.
RESEND_FROM_EMAIL=bewerbung@enactus-mannheim.com

# Reply-To on every outgoing mail — a real, actively read inbox, not the
# sending address above.
RESEND_REPLY_TO_EMAIL=info@unimannheim.enactus.team

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when it
# calls /api/cron/cleanup. Generate with `openssl rand -hex 32` or similar;
# with this unset, the cleanup route rejects every request.
CRON_SECRET=

# Public site URL, used for absolute links (OG images, hreflang, double opt-in confirmation)
# Local fallback matches the old Webflow site's domain — see docs/deployment.md.
NEXT_PUBLIC_SITE_URL=https://www.enactus-mannheim.com

# Shared password gating /admin/bewerbungen. Also doubles as the HMAC key
# signing that page's session cookie (docs/deployment.md) — no separate
# session secret. With this unset, the admin login route rejects every
# request rather than running unauthenticated. Generate with `openssl rand
# -hex 24` or similar; a real password the board can be told, not a
# machine-only secret, since there is no account system behind it.
ADMIN_PASSWORD=
